# Secrets
.env

# Streamlit — ignore secrets and everything else under .streamlit/, but track
# config.toml: it carries the app's light/dark theme (see CLAUDE.md →
# Architecture → Theme), so a local edit to it shows up in git status rather
# than being silently ignored.
.streamlit/*
!.streamlit/config.toml

# Python
.venv/
__pycache__/
*.pyc

# Tools
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# OS
.DS_Store
